{
  "name": "bakery-inventory",
  "version": "1.0.0",
  "description": "Sistema de inventario para panadería argentina - MVP Backend",
  "main": "src/app.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "jest --coverage --forceExit",
    "test:watch": "jest --watch"
  },
  "keywords": ["bakery", "inventory", "nodejs", "express", "supabase"],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@supabase/supabase-js": "^2.50.0",
    "dotenv": "^16.5.0",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^7.1.0"
  },
  "jest": {
    "testEnvironment": "node",
    "coverageThreshold": {
      "global": {
        "lines": 80,
        "functions": 80,
        "branches": 80,
        "statements": 80
      }
    },
    "collectCoverageFrom": [
      "src/**/*.js",
      "!src/server.js",
      "!src/models/**",
      "!src/routes/**",
      "!src/app.js"
    ]
  }
}
